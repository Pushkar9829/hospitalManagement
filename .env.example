# Copy to apps/api/.env for local development. Production values come from AWS Secrets Manager.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/hms?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# Hospital sub-domains resolve under this root: demo.localhost -> tenant "demo".
ROOT_DOMAIN=localhost
# RS256 key pair (PEM, \n-escaped). Leave empty in development to use a generated key pair.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
IDLE_TIMEOUT_MIN=15
SMS_PROVIDER=console
AWS_REGION=ap-south-1
S3_DOCS_BUCKET=
LOG_LEVEL=info
