{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["eslint.config.js", ".prettierrc.json", "packages/ui/src/tokens.css"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "test": {
      "outputs": [],
      "env": ["REDIS_URL"]
    },
    "test:int": {
      "cache": false,
      "env": ["REDIS_URL", "MONGO_TEST_URI", "MONGOMS_VERSION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
